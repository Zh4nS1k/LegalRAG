# ── [LegalRAG Production Environment Template] ──────────────────────────────────
# Instructions: Copy this file to `.env` in the project root and fill in the values.

# ├── AI Cloud Services ────────────────────────────────────────────────────────
# Groq: Used as the primary LLM engine. Get your key at https://console.groq.com
GROQ_API_KEY="gsk_your_groq_api_key_here"

# OpenRouter: optional LLM backend; set OPENROUTER_APP_NAME for usage dashboard grouping
OPENROUTER_API_KEY="sk-or-your_openrouter_api_key_here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL="https://legalrag.kz"
OPENROUTER_APP_NAME="LegalRAG-Tester"

# Pinecone: Used for vector storage and similarity search. Get your key at https://app.pinecone.io
PINECONE_API_KEY="pcsk_your_pinecone_api_key_here"
PINECONE_INDEX_NAME="legally-index"
PINECONE_NAMESPACE="default"

# Hugging Face: Used for fetching the embedding model (intfloat/multilingual-e5-large)
# Optional but highly recommended to avoid rate limits and warnings.
HF_TOKEN="hf_your_huggingface_token_here"

# ├── Performance & Optimization ───────────────────────────────────────────────
# Offline Mode: Set to 1 if you have already downloaded the embedding model
# to skip the Hugging Face hub network check and drastically speed up boot time.
HF_HUB_OFFLINE="0"
LEGAL_RAG_HF_LOCAL_ONLY="0"
LOG_FORMAT="human"

# Standalone Streamlit UI:
# Backend proxy that wraps the canonical Python AI entrypoint.
LEGAL_RAG_BACKEND_URL="http://localhost:8080"

# ├── LLM Configuration ────────────────────────────────────────────────────────
# Recommended profile:
# LEGAL_RAG_LLM_BACKEND="groq"
# LEGAL_RAG_LLM="llama-3.1-8b-instant"
# LEGAL_RAG_LLM_MAX_TOKENS="2500"
# LEGAL_RAG_USE_RERANKER="1"
# LEGAL_RAG_RERANK_DYNAMIC_SKIP="0"
LEGAL_RAG_GROQ_BREAKER_THRESHOLD="5"
LEGAL_RAG_GROQ_BREAKER_TIMEOUT="60"
LEGAL_RAG_PINECONE_BREAKER_THRESHOLD="3"
LEGAL_RAG_PINECONE_BREAKER_TIMEOUT="30"
#
# Local HuggingFace + LoRA profile:
# LEGAL_RAG_LLM_BACKEND="hf_peft"
# LEGAL_RAG_HF_BASE_MODEL="Qwen/Qwen2.5-7B-Instruct"
# LEGAL_RAG_HF_ADAPTER_PATH="./ai_service/models/legal-lora"
# LEGAL_RAG_HF_DEVICE_MAP="auto"
# LEGAL_RAG_HF_LOAD_IN_4BIT="1"
# LEGAL_RAG_HF_TORCH_DTYPE="float16"

# ├── Database Configuration (For Go Backend, if applicable) ───────────────────
MONGO_URI="mongodb://localhost:27017"
DB_NAME="legally_bot"

# ├── Access Management ────────────────────────────────────────────────────────
JWT_SECRET="your_jwt_secret_here"
ADMIN_IDS="991315506"
