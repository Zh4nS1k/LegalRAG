# === Pinecone ===
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_index_name
PINECONE_NAMESPACE=your_namespace          # optional, default ""
PINECONE_TOP_K=5                           # number of chunks to retrieve per query
PINECONE_SCORE_THRESHOLD=0.70             # minimum similarity score to include chunk

# === Embedding model ===
EMBEDDING_MODEL=intfloat/multilingual-e5-large   # HuggingFace model ID
EMBEDDING_PREFIX=query:                           # prefix for query embedding (e5 models)

# === LLM models to test (comma-separated list) ===
LLM_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3-32b

# === Groq API ===
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_RPM_DELAY=2.1                                # sleep between each LLM call to stay under 30 RPM

# === OpenRouter API ===
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://legalrag.kz
OPENROUTER_APP_NAME=LegalRAG-Tester               # shown in OpenRouter usage dashboard

# === IO ===
INPUT_EXCEL=questions.xlsx
INPUT_SHEET=Sheet1
QUESTION_COLUMN=question                          # column header name for questions
ID_COLUMN=id                                      # optional row ID column
OUTPUT_EXCEL=results.xlsx

# === Pipeline behavior ===
MAX_CONTEXT_TOKENS=3000                           # max tokens of chunk context to inject
REQUEST_TIMEOUT=60
MAX_RETRIES=3
RETRY_DELAY=2.0
LOG_LEVEL=INFO
CHUNK_TEXT_FIELD=text
